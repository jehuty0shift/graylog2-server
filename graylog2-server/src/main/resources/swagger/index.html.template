<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Graylog REST API browser</title>
  <base href="${baseUri}api-browser/${globalModePath}">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://unpkg.com/swagger-ui-dist@5.17.7/swagger-ui.css" rel="stylesheet" type="text/css" />
  <link href="css/browser.css" rel="stylesheet" type="text/css" />
</head>
<body data-api-docs-path="/api/api-docs${globalUriMarker}" data-show-warning="${showWarning}">
  <div id="header">
    <div class="swagger-ui-wrap">
      <img src="images/toplogo.png" alt="Graylog" />
      <span class="subtitle">REST API browser</span>
      <form id="api_selector" autocomplete="off">
        <div class="input">
          <label for="input_apiUser">Username</label>
          <input type="text" name="user" id="input_apiUser" placeholder="Username" />
        </div>
        <div class="input">
          <label for="input_apiPassword">Password</label>
          <input type="password" name="password" id="input_apiPassword" placeholder="Password" />
        </div>
        <span id="auth_status">Not authenticated</span>
      </form>
    </div>
  </div>

  <div class="warning-box" id="warning_box">
    The cluster-global API browser must be accessed through the configured external URI to allow "Try it out" requests.
  </div>

  <main>
    <nav id="resources">
      <header>
        <h2>Resources</h2>
      </header>
      <div class="resource-list" id="resource_list"></div>
    </nav>
    <section id="operations" aria-live="polite">
      <p id="operations_message" class="operations-message is-visible">Select a resource to view its operations.</p>
      <div id="swagger_ui" class="swagger-ui"></div>
    </section>
  </main>

  <script src="https://unpkg.com/swagger-ui-dist@5.17.7/swagger-ui-bundle.js" type="text/javascript"></script>
  <script src="https://unpkg.com/swagger-ui-dist@5.17.7/swagger-ui-standalone-preset.js" type="text/javascript"></script>
${if ! nonce = "EMPTY" }
  <script nonce='${nonce}' src='swagger-script.js' type='text/javascript'></script>
${else}
  <script src='swagger-script.js' type='text/javascript'></script>
${end}
</body>
</html>
